

{% liquid
  assign block_settings = block.settings
%}

<div class="coverage-item" {{ block.shopify_attributes }}>
  <div class="coverage-item__media">
    {% if block_settings.image != blank %}
      {{
        block_settings.image
        | image_url: width: 600
        | image_tag:
          widths: '150, 300, 450, 600',
          sizes: '(min-width: 990px) 200px, 33vw',
          loading: 'lazy',
          class: 'coverage-item__image'
      }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'coverage-item__image coverage-item__image--placeholder' }}
    {% endif %}
  </div>
  <div
    class="coverage-item__label"
    style="background-color: {{ block_settings.label_background }}; color: {{ block_settings.label_color }};"
  >
    {{ block_settings.label | escape | newline_to_br }}
  </div>
</div>

{% stylesheet %}
  .coverage-item {
    display: flex;
    flex-direction: column;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgb(0 0 0 / 0.08);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.06);
    background: #fff;
    height: 100%;
  }

  .coverage-item__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .coverage-item__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .coverage-item__label {
    margin-top: auto;
    padding: 10px 8px;
    text-align: center;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Área de cobertura",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "textarea",
      "id": "label",
      "label": "Etiqueta",
      "default": "Hospitalización"
    },
    {
      "type": "color",
      "id": "label_background",
      "label": "Color de fondo de la etiqueta",
      "default": "#1C4E80"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Color del texto",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Área de cobertura"
    }
  ]
}
{% endschema %}
