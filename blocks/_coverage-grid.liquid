

<div
  class="coverage-grid"
  style="--coverage-grid-columns: {{ block.settings.columns }}; --coverage-grid-gap: {{ block.settings.gap }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .coverage-grid {
    display: grid;
    grid-template-columns: repeat(var(--coverage-grid-columns, 5), 1fr);
    gap: var(--coverage-grid-gap, 16px);
  }

  @media screen and (max-width: 989px) {
    .coverage-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 599px) {
    .coverage-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cuadrícula de cobertura",
  "tag": null,
  "blocks": [
    {
      "type": "_coverage-item"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas (escritorio)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espacio entre tarjetas",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ]
}
{% endschema %}
