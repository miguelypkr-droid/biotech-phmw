

<div
  class="checklist"
  style="--checklist-gap: {{ block.settings.gap }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .checklist {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--checklist-gap, 24px) 40px;
  }

  @media screen and (max-width: 599px) {
    .checklist {
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lista de verificación",
  "tag": null,
  "blocks": [
    {
      "type": "_checklist-item"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "Espacio entre elementos",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
