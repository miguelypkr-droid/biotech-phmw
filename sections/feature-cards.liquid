

{% liquid
  assign custom_color = false
  if section.settings.background_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="feature-cards spacing-style section section--{{ section.settings.section_width }}{% if custom_color %} color-custom-{{ section.id }}{% endif %} disable-section-top-offset"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div
    class="feature-cards__row"
    style="--feature-cards-gap: {{ section.settings.items_gap }}px;"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .feature-cards__row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: var(--feature-cards-gap, 32px);
  }

  .feature-cards__row > .group-block {
    flex: 1 1 280px;
    max-width: 400px;
  }
{% endstylesheet %}

{% schema %}
