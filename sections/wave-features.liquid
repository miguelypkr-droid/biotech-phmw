

{% liquid
  assign has_background_image = false
  if section.settings.background_image != blank
    assign has_background_image = true
  endif

  assign top_wave_color = section.settings.top_wave_color | default: settings.page_background_color
  assign bottom_wave_color = section.settings.bottom_wave_color | default: settings.page_background_color

  assign custom_color = false
  if section.settings.background_color != blank or section.settings.text_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"
>
  {% if has_background_image %}
    {% render 'background-media',
      background_media: 'image',
      background_image: section.settings.background_image,
      background_image_position: 'cover',
      section: section
    %}
  {% endif %}
</div>

<div
  class="wave-features spacing-style section section--{{ section.settings.section_width }}{% if custom_color %} color-custom-{{ section.id }}{% endif %} disable-section-top-offset"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  {% if section.settings.show_top_wave %}
    <div
      class="wave-features__divider wave-features__divider--top"
      aria-hidden="true"
      style="color: {{ top_wave_color }}; --wave-height: {{ section.settings.top_wave_height }}px;"
    >
      <svg
        viewBox="0 0 1440 120"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M0,40 C 240,110 480,0 720,40 C 960,80 1200,20 1440,60 L1440,120 L0,120 Z"
          fill="currentColor"
        />
      </svg>
    </div>
  {% endif %}

  <div
    class="wave-features__row"
    style="--wave-features-gap: {{ section.settings.items_gap }}px;"
  >
    {% content_for 'blocks' %}
  </div>

  {% if section.settings.show_bottom_wave %}
    <div
      class="wave-features__divider wave-features__divider--bottom"
      aria-hidden="true"
      style="color: {{ bottom_wave_color }}; --wave-height: {{ section.settings.bottom_wave_height }}px;"
    >
      <svg
        viewBox="0 0 1440 120"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M0,40 C 240,110 480,0 720,40 C 960,80 1200,20 1440,60 L1440,120 L0,120 Z"
          fill="currentColor"
        />
      </svg>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .wave-features {
    position: relative;
    overflow: hidden;
  }

  .wave-features__divider {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--wave-height, 60px);
    line-height: 0;
    z-index: var(--layer-flat);
    pointer-events: none;
  }

  .wave-features__divider svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wave-features__divider--top {
    top: 0;
    transform: rotate(180deg);
  }

  .wave-features__divider--bottom {
    bottom: 0;
  }

  .wave-features__row {
    position: relative;
    z-index: var(--layer-raised);
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: var(--wave-features-gap, 32px);
    text-align: center;
  }

  .wave-features__row > .group-block {
    flex: 1 1 200px;
    max-width: 260px;
  }

  @media screen and (min-width: 750px) {
    .wave-features__row > .group-block:not(:first-child) {
      border-left: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.12);
    }
  }
{% endstylesheet %}

