

{% liquid
  assign custom_color = false
  if section.settings.background_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="coverage-process spacing-style section section--{{ section.settings.section_width }}{% if custom_color %} color-custom-{{ section.id }}{% endif %} disable-section-top-offset"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="coverage-process__inner">
    {% if section.settings.heading != blank %}
      <div class="coverage-process__heading-wrap">
        <span
          class="coverage-process__heading"
          style="color: {{ section.settings.heading_color }};"
        >
          {{- section.settings.heading | escape -}}
        </span>
      </div>
    {% endif %}

    <div
      class="coverage-process__grid"
      style="--coverage-process-grid-columns: {{ section.settings.grid_columns }}; --coverage-process-grid-gap: {{ section.settings.grid_gap }}px;"
    >
      {% content_for 'blocks' %}
    </div>

    {% content_for 'block', type: 'group', id: 'process' %}

    {% content_for 'block', type: 'group', id: 'checklist' %}
  </div>
</div>

{% stylesheet %}
  .coverage-process__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .coverage-process__heading-wrap {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .coverage-process__heading-wrap::before,
  .coverage-process__heading-wrap::after {
    content: '';
    flex: 1 1 auto;
    height: 2px;
    background-color: currentColor;
    opacity: 0.35;
  }

  .coverage-process__heading {
    flex: 0 0 auto;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
  }

  .coverage-process__grid {
    display: grid;
    grid-template-columns: repeat(var(--coverage-process-grid-columns, 5), 1fr);
    gap: var(--coverage-process-grid-gap, 16px);
  }

  .coverage-process__grid > .group-block {
    height: 100%;
  }

  .coverage-process__grid .group-block-content {
    height: 100%;
  }

  @media screen and (max-width: 989px) {
    .coverage-process__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 599px) {
    .coverage-process__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

