

{% liquid
  assign custom_color = false
  if section.settings.background_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="equipment-showcase spacing-style section section--{{ section.settings.section_width }}{% if custom_color %} color-custom-{{ section.id }}{% endif %} disable-section-top-offset"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div
    class="equipment-showcase__inner"
    style="border-color: {{ section.settings.box_border_color }}; border-radius: {{ section.settings.box_corner_radius }}px;"
  >
    {% if section.settings.heading != blank %}
      <div class="equipment-showcase__heading-wrap">
        <span
          class="equipment-showcase__heading"
          style="color: {{ section.settings.heading_color }};"
        >
          {{- section.settings.heading | escape -}}
        </span>
      </div>
    {% endif %}

    <div
      class="equipment-showcase__grid"
      style="--equipment-showcase-columns: {{ section.settings.grid_columns }}; --equipment-showcase-gap: {{ section.settings.grid_gap }}px;"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .equipment-showcase__inner {
    border-style: solid;
    border-width: 1px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .equipment-showcase__heading-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .equipment-showcase__heading-wrap::before,
  .equipment-showcase__heading-wrap::after {
    content: '';
    flex: 1 1 auto;
    height: 1px;
    background-color: currentColor;
    opacity: 0.35;
  }

  .equipment-showcase__heading {
    flex: 0 0 auto;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .equipment-showcase__grid {
    display: grid;
    grid-template-columns: repeat(var(--equipment-showcase-columns, 4), 1fr);
    gap: var(--equipment-showcase-gap, 24px);
    justify-items: center;
  }

  @media screen and (max-width: 989px) {
    .equipment-showcase__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 480px) {
    .equipment-showcase__grid {
      grid-template-columns: repeat(1, 1fr);
    }
  }
{% endstylesheet %}

