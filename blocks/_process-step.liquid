

{% liquid
  assign block_settings = block.settings
  assign icon_class = 'process-step__icon process-step__icon-' | append: block.id
%}

{% if block_settings.icon_color != blank %}
  {% style %}
    .process-step__icon-{{ block.id }} {
      color: {{ block_settings.icon_color }};
    }
  {% endstyle %}
{% endif %}

<div class="process-step" {{ block.shopify_attributes }}>
  {% if block_settings.icon != 'none' or block_settings.image_upload != blank %}
    {% render 'icon-or-image',
      icon: block_settings.icon,
      image_upload: block_settings.image_upload,
      width: block_settings.icon_width,
      class_name: icon_class
    %}
  {% endif %}

  {% if block_settings.label != blank %}
    <p class="process-step__label">{{ block_settings.label | escape }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .process-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    flex: 0 1 150px;
    text-align: center;
    position: relative;
    padding-inline: 14px;
  }

  .process-step__icon {
    height: auto;
    color: currentColor;
  }

  .process-step__label {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .process-step:not(:last-child)::after {
    content: '\203A';
    position: absolute;
    top: 14px;
    right: -4px;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    color: currentColor;
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .process-step:not(:last-child)::after {
      content: none;
    }
  }
{% endstylesheet %}

