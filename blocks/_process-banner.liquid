

{% liquid
  assign block_settings = block.settings
%}

<div
  class="process-banner"
  style="background-color: {{ block_settings.background_color }}; color: {{ block_settings.text_color }}; border-radius: {{ block_settings.corner_radius }}px;"
  {{ block.shopify_attributes }}
>
  {% if block_settings.heading != blank %}
    <p class="process-banner__heading">{{ block_settings.heading | escape }}</p>
  {% endif %}

  <div class="process-banner__steps">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .process-banner {
    padding: 32px 24px;
  }

  .process-banner__heading {
    margin: 0 0 28px;
    text-align: center;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .process-banner__steps {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: 8px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner de proceso",
  "tag": null,
  "blocks": [
    {
      "type": "_process-step"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Te Acompañamos En Todo El Proceso"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#1C4E80"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Radio de las esquinas",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ]
}
{% endschema %}
